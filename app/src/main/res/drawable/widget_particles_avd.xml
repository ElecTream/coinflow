<?xml version="1.0" encoding="utf-8"?>
<!--
  Particle field: 16 soft circles drifting upward, looping forever.
  Authored in white — WidgetUpdater applies a color filter for the active theme.
  Each particle has a unique duration + startOffset for organic, non-synchronised movement.
-->
