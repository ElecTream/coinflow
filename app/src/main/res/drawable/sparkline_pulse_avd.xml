<?xml version="1.0" encoding="utf-8"?>
<!--
  Sparkline endpoint pulse: a circle that expands from small to large while fading out,
  centred at the right-hand end of the sparkline area (where the live-price dot sits).
  Loops every 2.5 s to suggest a live data feed.
  Authored in white — WidgetUpdater applies a color filter for the active theme.
-->
<animated-vector
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">

    <aapt:attr name="android:drawable">
        <vector
            android:width="360dp"
            android:height="36dp"
            android:viewportWidth="360"
            android:viewportHeight="36">

            <group
                android:name="pulse_group"
                android:pivotX="340"
                android:pivotY="18"
                android:scaleX="0.2"
                android:scaleY="0.2">
                <path
                    android:fillColor="#80FFFFFF"
                    android:pathData="M340,18 m-10,0 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0"/>
            </group>

        </vector>
    </aapt:attr>

    <!-- Scale from 0.2 → 1.6 (expands outward) -->
    <target android:name="pulse_group">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX"
                    android:valueFrom="0.2" android:valueTo="1.6"
                    android:duration="2500" android:startOffset="0"
                    android:repeatCount="infinite" android:repeatMode="restart"
                    android:interpolator="@android:interpolator/decelerate_quad"/>
                <objectAnimator android:propertyName="scaleY"
                    android:valueFrom="0.2" android:valueTo="1.6"
                    android:duration="2500" android:startOffset="0"
                    android:repeatCount="infinite" android:repeatMode="restart"
                    android:interpolator="@android:interpolator/decelerate_quad"/>
                <objectAnimator android:propertyName="alpha"
                    android:valueFrom="0.7" android:valueTo="0.0"
                    android:duration="2500" android:startOffset="0"
                    android:repeatCount="infinite" android:repeatMode="restart"
                    android:interpolator="@android:interpolator/decelerate_quad"/>
            </set>
        </aapt:attr>
    </target>

</animated-vector>
