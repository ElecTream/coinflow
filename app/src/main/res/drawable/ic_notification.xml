<?xml version="1.0" encoding="utf-8"?>
<!--
  Notification status-bar icon for Coinflow.
  Rules for Android notification icons:
    - 24×24dp canvas, single layer, white fill only (#FFFFFF)
    - No colors — the system applies white tint automatically
    - Simple flat shape readable at ~16dp in the status bar
  Design: coin outline (ring) with a small upward price arrow inside.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Coin ring -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="
          M12,2
          A10,10 0 1,0 12,22
          A10,10 0 1,0 12,2 Z
          M12,5
          A7,7 0 1,1 12,19
          A7,7 0 1,1 12,5 Z" />

    <!-- Upward trend arrow inside the coin -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M8.5,15 L11,11.5 L13,13.5 L15.5,9 L16.5,10 L13,16 L11,14 L9.5,16 Z" />

</vector>
