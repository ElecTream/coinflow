            android:height="220dp"
            android:viewportWidth="360"
            android:viewportHeight="220">

            <!-- p1  x=30  y=180 r=2.0 -->
            <group android:name="p1">
                <path android:fillColor="#47FFFFFF"
                      android:pathData="M30,180 m-2,0 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0"/>
            </group>
            <!-- p2  x=80  y=50  r=3.0 -->
            <group android:name="p2">
                <path android:fillColor="#33FFFFFF"
                      android:pathData="M80,50 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0"/>
            </group>
            <!-- p3  x=130 y=130 r=2.0 -->
