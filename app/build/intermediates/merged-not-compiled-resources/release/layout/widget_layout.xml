<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="8dp">

    <!-- TOP ROW: coin tabs + refresh -->
    <LinearLayout
        android:id="@+id/top_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tab_coin_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="10sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.06"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tab_coin_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="10sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.06"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tab_coin_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="10sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.06"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tab_coin_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="10sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.06"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tab_coin_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="10sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.06"
            android:visibility="gone" />

        <View
            android:id="@+id/tab_divider"
            android:layout_width="1dp"
            android:layout_height="12dp"
            android:background="#33FFFFFF"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/btn_refresh"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_refresh"
            android:contentDescription="Refresh" />
    </LinearLayout>

    <!-- PRICE + 24H CHANGE on one inline row (saves vertical space) -->
    <LinearLayout
        android:id="@+id/price_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <TextView
            android:id="@+id/tv_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="$0.0000" />

        <TextView
            android:id="@+id/tv_change"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#00FF88"
            android:singleLine="true"
            android:text="▲ 0.00%" />

        <LinearLayout
            android:id="@+id/wallet_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#00D4FF"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:text="" />

            <TextView
                android:id="@+id/tv_portfolio_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#8899BB"
                android:textSize="9sp"
                android:fontFamily="sans-serif-light"
                android:singleLine="true"
                android:text="" />
        </LinearLayout>
    </LinearLayout>

    <!-- SPARKLINE -->
    <ImageView
        android:id="@+id/iv_sparkline"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:scaleType="fitXY"
        android:contentDescription="Price chart" />

    <!-- BOTTOM ROW: timestamp + settings -->
    <LinearLayout
        android:id="@+id/bottom_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="2dp">

        <TextView
            android:id="@+id/tv_last_updated"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#5A5A88"
            android:textSize="9sp"
            android:fontFamily="sans-serif-light"
            android:singleLine="true"
            android:text="Updating…" />

        <ImageView
            android:id="@+id/btn_settings"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/widget_settings_icon"
            android:contentDescription="Settings" />
    </LinearLayout>

</LinearLayout>
