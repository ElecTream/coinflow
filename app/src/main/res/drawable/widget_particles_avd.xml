    </aapt:attr>

    <!-- Each particle translates upward by 230 units (clears the 220-unit viewport).
         Staggered startOffsets ensure particles are always spread at different heights. -->

    <target android:name="p1">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="translateY"
                android:valueFrom="0" android:valueTo="-230"
                android:duration="7200" android:startOffset="0"
                android:repeatCount="infinite" android:repeatMode="restart"
                android:interpolator="@android:interpolator/linear"/>
        </aapt:attr>
    </target>
